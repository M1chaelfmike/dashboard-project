generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// System permission roles
enum UserRole {
  ADMIN
  MEMBER
}

// Account lifecycle status
enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

// Audit log categories
enum AuditLogCategory {
  BUSINESS_ACTIVITY
  AUTHENTICATION
  SECURITY_EVENT
  DATA_ACCESS

  @@map("audit_log_category")
}

// Audit operation result
enum AuditLogResult {
  SUCCESS
  FAILURE

  @@map("audit_log_result")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  // Profile information
  name  String? @db.VarChar(100)
  email String  @unique @db.VarChar(254)

  // Authentication
  passwordHash String @map("password_hash") @db.VarChar(255)

  // Authorization and account status
  role   UserRole   @default(MEMBER)
  status UserStatus @default(PENDING_APPROVAL)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Filtering indexes
  @@index([role, status], map: "users_role_status_idx")
  @@index([status], map: "users_status_idx")
  // Name substring search (ILIKE)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

model Company {
  companyCode String @id @map("company_code") @db.VarChar(32)
  companyName String @map("company_name") @db.VarChar(255)

  level   Int
  country String @db.VarChar(100)
  city    String @db.VarChar(100)

  foundedYear   Int @map("founded_year")
  annualRevenue Int @map("annual_revenue")
  employees     Int

  // Relationships
  ownRelationship    CompanyRelationship?  @relation("CompanyAsChild")
  childRelationships CompanyRelationship[] @relation("CompanyAsParent")

  // Indexes
  @@index([level], map: "companies_level_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "companies_name_trgm_idx")
  @@map("companies")
}

model CompanyRelationship {
  companyCode       String  @id @map("company_code") @db.VarChar(32)
  parentCompanyCode String? @map("parent_company") @db.VarChar(32)

  // Current company
  company Company @relation("CompanyAsChild", fields: [companyCode], references: [companyCode], onDelete: Cascade)

  // Parent company
  parentCompany Company? @relation("CompanyAsParent", fields: [parentCompanyCode], references: [companyCode], onDelete: Restrict)

  // Index
  @@index([parentCompanyCode], map: "company_relationships_parent_idx")
  @@map("company_relationships")
}

// Centralized audit log
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // Classification
  category AuditLogCategory
  action   String           @db.VarChar(100)
  result   AuditLogResult

  // Operator snapshot
  actorId   String? @map("actor_id") @db.VarChar(64)
  actorName String? @map("actor_name") @db.VarChar(100)
  actorRole String? @map("actor_role") @db.VarChar(20)

  // Target resource snapshot
  targetType String? @map("target_type") @db.VarChar(50)
  targetId   String? @map("target_id") @db.VarChar(128)
  targetName String? @map("target_name") @db.VarChar(255)

  // Additional information
  metadata  Json?   @db.JsonB
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Dashboard query index
  @@index([category, result, createdAt(sort: Desc)], map: "audit_logs_category_result_created_at_idx")
  // Operator history index
  @@index([actorId, createdAt(sort: Desc)], map: "audit_logs_actor_created_at_idx")
  // Target resource history index
  @@index([targetType, targetId, createdAt(sort: Desc)], map: "audit_logs_target_created_at_idx")
  // Recent activity query index
  @@index([category, createdAt(sort: Desc)], map: "audit_logs_category_created_at_idx")
  @@map("audit_logs")
}
